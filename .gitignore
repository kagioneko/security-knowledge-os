# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Secrets & local config (decision A3, 2026-09-10)
.env
*.local
*.key
*.pem
